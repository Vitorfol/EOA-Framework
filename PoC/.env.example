# LLM API Keys (opcional - apenas se usar adapters externos)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=your_gemini_model_here

# Model Paths
MODELS_DIR=layers/training/models
RESULTS_DIR=layers/training/results

# Dataset Paths (ajuste para o caminho local dos seus datasets)
HYDRAULIC_DATASET_PATH=your_hydraulic_dataset_path (https://archive.ics.uci.edu/dataset/447/condition+monitoring+of+hydraulic+systems)
HYDROPOWER_DATASET_PATH=your_hydropower_dataset_path (https://researchdata.se/en/catalogue/dataset/2025-35)
KAGGLE_CACHE_DIR=kaggle_dataset_import (https://www.kaggle.com/datasets/dnkumars/industrial-equipment-monitoring-dataset/discussion?sort=undefined)

# Domain path
DOMAIN_PATH=your_domain_path

# Agent Configuration
AGENT_JUDGE_MIN_SCORE=your_minimum_judge_score
AGENT_MAX_ATTEMPTS=your_max_attempts
AGENT_SYSTEM_PROMPT_PATH=layers/agent/prompts/system_prompt.txt
AGENT_JUDGE_PROMPT_PATH=layers/agent/prompts/judge_prompt.txt
AGENT_PAYLOAD_DIR=layers/agent/mock
